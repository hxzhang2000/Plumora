{
  "name": "@plumora/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "观梅 · Plumora Web 端（电脑端 + 移动端自适应）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
