    "test:runtime": "vite build --config vite.smoke.config.ts && node scripts/runtime-smoke.cjs"
  },
  "dependencies": {
    "@plumora/core": "*",
    "@plumora/knowledge": "*",
    "@plumora/lunar": "*",
