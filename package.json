{
  "name": "plumora",
  "version": "0.5.0",
  "private": true,
  "description": "观梅 · Plumora — 梅花易数起卦排盘工具（Web + Android 双端，当前实现 Web 端）",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @plumora/web",
    "build": "npm run build -w @plumora/web",
    "preview": "npm run preview -w @plumora/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:runtime": "npm run test:runtime -w @plumora/web",
    "version:show": "node scripts/version.mjs show",
    "version:sync": "node scripts/version.mjs sync",
    "version:check": "node scripts/version.mjs check",
    "version:bump": "node scripts/version.mjs bump",
    "version:bump:patch": "node scripts/version.mjs bump patch",
    "version:bump:minor": "node scripts/version.mjs bump minor",
    "version:bump:major": "node scripts/version.mjs bump major",
    "knowledge:build": "node scripts/build-strokes.mjs",
    "knowledge:adjudicate": "node scripts/adjudicate-strokes.mjs",
    "verify": "npm run version:check && npm run typecheck && npm run test && npm run test:runtime && npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
